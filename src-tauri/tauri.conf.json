{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zenithdb",
  "version": "0.1.0",
  "identifier": "com.tcs.zenithdb",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/zenithdb/browser"
  },
  "app": {
    "windows": [
      {
        "title": "ZenithDB - Professional Database Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
