# Configuration for the Forge shell.
#
# Copy this file to `.env` and adjust it. `.env` is ignored by git, written
# 0600 by the engine's `app_env` handler, and never synced to the cloud: it
# holds machine-local settings, never content.
#
# The app's content (pages, entities, chains) lives outside this repository.
# The library finds it by itself; the variables below only override that.

# The app's identity. The boot argument records it only when the environment
# does not already name one, so a value here must match the bundle id the app
# boots with. Reloadable.
# FORGE_BUNDLE_ID=com.tcs.zenithdb

# Boot-only: read before the store and the servers are built, so a change
# needs a restart.
# The content root: the directory with one subdirectory per app.
# FORGE_SCHEMAS_DB=/mnt/external/Projects/schemas_db
# The engine's HTTP / action port (FORGE_ACTION_PORT is the legacy name).
# FORGE_PORT=18765
# FORGE_ACTION_PORT=18765
# The UI control server: the port, and the switch that enables it.
# FORGE_UI_PORT=18766
# FORGE_UI_CONTROL=1
# The secret the auth handlers sign with.
# FORGE_AUTH_SECRET=change-me
# Selects the legacy content loader (1 = on).
# FORGE_LEGACY_LOADER=1
# Names another `.env` file, bypassing the resolution order.
# FORGE_ENV_FILE=/mnt/external/Projects/ZenithDB/.env

# Reloadable: applied when the file changes.
# The cloud database a cloud deployment uses.
# FORGE_MONGO_URI=mongodb://127.0.0.1:27017
# FORGE_MONGO_DB=forge_zenithdb

# The directory the app's own assets (its logo) is served from.
# The library finds the app's `assets/` directory by itself.
# FORGE_ASSETS_DIR=assets
# Turns a verification warning into a failure.
# FORGE_VERIFY_STRICT=1
