{
  "app": {
    "name": "ZenithDB",
    "id": "com.tcs.zenithdb"
  },
  "entities": [
    {
      "name": "Connection",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "kind",
          "type": "string",
          "required": true,
          "default": null,
          "allowed": [
            "postgres",
            "sqlite",
            "mysql",
            "mongodb",
            "redis"
          ]
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "default": null
        },
        {
          "name": "uri",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "database",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "config",
          "type": "json",
          "required": false,
          "default": null
        },
        {
          "name": "created_at",
          "type": "date",
          "required": false,
          "default": null
        },
        {
          "name": "updated_at",
          "type": "date",
          "required": false,
          "default": null
        }
      ]
    },
    {
      "name": "Role",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "default": null
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "default": null
        }
      ]
    },
    {
      "name": "User",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "default": null
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "default": null
        },
        {
          "name": "password_hash",
          "type": "string",
          "required": true,
          "default": null
        },
        {
          "name": "created_at",
          "type": "date",
          "required": false,
          "default": null
        }
      ]
    }
  ],
  "pages": [
    {
      "route": "/connections",
      "title": "Connections",
      "components": [
        {
          "type": "list",
          "source": "Connection"
        },
        {
          "type": "button",
          "label": "New Connection",
          "action": "new_connection"
        }
      ]
    },
    {
      "route": "/new-connection",
      "title": "New Connection",
      "components": [
        {
          "type": "form",
          "entity": "Connection",
          "fields": [
            "kind",
            "name",
            "uri",
            "database",
            "config"
          ]
        },
        {
          "type": "button",
          "label": "Save",
          "action": "save_connection"
        },
        {
          "type": "button",
          "label": "Test",
          "action": "test_connection_status"
        }
      ]
    },
    {
      "route": "/explorer",
      "title": "Explorer",
      "components": [
        {
          "type": "table",
          "source": "Connection"
        },
        {
          "type": "input",
          "placeholder": "Search...",
          "action": "query"
        }
      ]
    },
    {
      "route": "/workbench",
      "title": "Workbench",
      "components": [
        {
          "type": "textarea",
          "placeholder": "Enter query...",
          "action": "query"
        },
        {
          "type": "button",
          "label": "Run",
          "action": "query"
        }
      ]
    },
    {
      "route": "/settings",
      "title": "Settings",
      "components": [
        {
          "type": "form",
          "entity": "User"
        },
        {
          "type": "button",
          "label": "Save",
          "action": "save_settings"
        }
      ]
    }
  ],
